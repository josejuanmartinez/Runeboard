    - target: {fileID: 5573347797707965420, guid: fc704c900dcc75f488c3ac45c382d7f2, type: 3}
      propertyPath: m_text
      value: 'Cards may have class level <sprite name="commander"><sprite name="agent"><sprite
        name="emmissary"><sprite name="mage"> or resource <sprite name="leather">
        <sprite name="timber"> <sprite name="mounts"> <sprite name="iron"> <sprite
        name="mithril"> <sprite name="gold"> requirements.


        The action type
        (The action type (<color=#9ACD32>Encounter</color>, <color=#82F1E5>Environmental</color>,
        <color=#FF00C2>Action</color>, <color=#DAA520>Army</color>, <color=#1E90FF>PC</color>,
        <color=#6B8E23>Land</color>, <color=#FF69B4>Character</color>, <color=#444444>Event</color>,
        <color=#A020F0>Spell</color>) the <color=white>description</color> and a
        <color=#444444>quote</color> can be found below. The icon on the top right
        is of the deck it belongs to (  <sprite name=fire>)'
      objectReference: {fileID: 0}
