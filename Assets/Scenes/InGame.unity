    - target: {fileID: 5573347797707965420, guid: fc704c900dcc75f488c3ac45c382d7f2, type: 3}
      propertyPath: m_text
      value: 'Hexes will show the presence of:

        - Artifacts <sprite name="artifact">,
        encounters <sprite name="encounter">, <color=#964B00>underground</color>
        entrances.

        - Presence of Population Centers <sprite name="pc"> and
        their loyalty <sprite name="loyalty">, fortifications <sprite name="fort">,
        port <sprite name="port">

        - Class levels of the selected character
        <sprite name="commander"><sprite name="agent"><sprite name="emmissary"><sprite
        name="mage">

        - Spotted characters of different alignments <sprite
        name="freePeopleCharacter"><sprite name="neutralCharacter"><sprite name="darkServantsCharacter">

        -
        Armies of different alignments <sprite name="freePeople"><sprite name="neutral"><sprite
        name="darkServants">.


        You can hover for more nformation.

'
      objectReference: {fileID: 0}
